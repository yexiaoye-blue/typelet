{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Typelet",
  "version": "0.1.0",
  "identifier": "dev.typelet.typing",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Typelet",
        "width": 380,
        "height": 450,
        "minWidth": 340,
        "minHeight": 450,
        "maxWidth": 460,
        "maxHeight": 650,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A small floating typing practice tool"
  }
}
