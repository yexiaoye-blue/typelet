{
  "name": "typelet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "web:dev": "vite --host 127.0.0.1 --port 6670 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "cargo test --manifest-path src-tauri/typing-core/Cargo.toml && tsx --test tests/typing.test.ts tests/key-sounds.test.ts tests/fonts.test.ts",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "canvas-confetti": "^1.9.4",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=24"
  },
  "description": "A small floating typing practice tool"
}
